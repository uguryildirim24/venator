{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default window permissions plus opening employer postings in the real browser.",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{
					"url": "https://*"
				},
				{
					"url": "http://*"
				}
			]
		}
	]
}
