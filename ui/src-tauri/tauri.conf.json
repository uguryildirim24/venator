{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Venator",
	"version": "0.1.0",
	"identifier": "com.venator.dashboard",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm sidecar && pnpm dev",
		"beforeBuildCommand": "pnpm desktop:stage && pnpm build:desktop"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Venator",
				"width": 1320,
				"height": 880,
				"minWidth": 960,
				"minHeight": 620,
				"resizable": true,
				"fullscreen": false,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"macOS": { "signingIdentity": "-", "hardenedRuntime": false },
		"targets": [
			"app",
			"dmg",
			"nsis"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": [
			"binaries/node"
		],
		"resources": [
			"resources/server.mjs",
			"resources/parse_resume.py",
			"resources/resolve_board.py",
			"resources/verify_profile.py",
			"resources/plan.py",
			"resources/python/**/*"
		]
	}
}
