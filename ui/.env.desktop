# The environment `pnpm build:desktop` builds the desktop bundle under, loaded by Vite for
# `--mode desktop` and by nothing else.
#
# It exists because this value used to be a POSIX assignment prefix in package.json —
# `VITE_API_BASE=... vite build` — which is not a thing any Windows shell parses. pnpm runs a
# script through cmd.exe on Windows, so the whole desktop build, and with it every attempt to
# produce a Windows installer, died at `'VITE_API_BASE' is not recognized as an internal or
# external command`. A mode file says the same thing in a form both hosts read.
#
# Why the value: a webview page is served from `tauri://localhost`, where a relative `/api`
# resolves against the app protocol and reaches nothing. The desktop build has to name the
# sidecar's loopback origin outright. `src/api.ts` is the one place that reads it.
VITE_API_BASE=http://127.0.0.1:5170/api
